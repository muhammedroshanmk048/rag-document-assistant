# "gemini" (free API key from https://aistudio.google.com/apikey) or "ollama" (local, offline)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Only used when LLM_PROVIDER=ollama (run `ollama pull llama3.2` first)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Retrieval tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Public deployment limits (per browser session)
MAX_UPLOAD_MB=10
MAX_DOCS_PER_SESSION=5
MAX_CHUNKS_PER_DOC=300
DOC_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30
CHAT_REQUESTS_PER_MINUTE=10
